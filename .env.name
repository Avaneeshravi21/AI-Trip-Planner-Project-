# ============================================================
# AI Trip Planner — Environment Variables
# Copy this file to ".env" and fill in the keys marked REQUIRED.
# This project can run 100% FREE using only the 4 required keys below.
# ============================================================

# ---- REQUIRED (all have free tiers, no credit card needed) ----

# Free LLM — sign up at https://console.groq.com/keys
GROQ_API_KEY=""

# Free web/place search fallback (also the ONLY place-search source
# if you don't set up Google Places below) — https://tavily.com
TAVILY_API_KEY=""

# Free weather data — https://home.openweathermap.org/users/sign_up
OPENWEATHERMAP_API_KEY=""

# Free currency conversion (free plan, email signup only)
# https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=""


# ---- OPTIONAL (leave blank to stay 100% free) ----

GPLACES_API_KEY=""
OPENAI_API_KEY=""